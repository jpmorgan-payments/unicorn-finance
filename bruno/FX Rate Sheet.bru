meta {
  name: FX Rate Sheet
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/fxapi/v1/rate-sheets
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "accountId": "000000010900009",
    "currency": "USD"
  }
}

docs {
  Returns the guaranteed USD → EUR rate (0.9231) that turns $1,000,000 into
  exactly €923,100 to settle INV-2026-4417. Runs in-app via MSW today; add an
  FX Prism spec + Caddy route to serve it from the mock-server.
}
