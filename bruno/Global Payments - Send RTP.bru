meta {
  name: Global Payments - Send RTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/payment/v2/payments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "requestedExecutionDate": "2026-08-20",
    "paymentIdentifiers": { "endToEndId": "UF1756000002" },
    "transferType": "CREDIT",
    "value": { "currency": "USD", "amount": "1000000" },
    "paymentType": "RTP",
    "debtor": {
      "name": "Unicorn Finance - San Jose",
      "account": { "accountNumber": "000000010900009", "accountType": "DDA", "accountCurrency": "USD" }
    },
    "debtorAgent": {
      "name": "JPMorgan Chase - San Jose",
      "financialInstitutionIds": [{ "id": "021000021", "idType": "USABA" }]
    },
    "creditor": {
      "name": "Palo Alto Robotics LLC",
      "account": { "accountNumber": "000000010900042" }
    },
    "creditorAgent": {
      "financialInstitutionIds": [{ "id": "121000248", "idType": "USABA" }]
    },
    "remittanceInformation": {
      "structuredInformation": [{ "creditReference": { "reference": "INV-2026-4417" } }]
    }
  }
}

docs {
  $1,000,000 from San Jose to Palo Alto, same state, same currency, over RTP.
  RTP's network cap is $10,000,000 per transaction (raised from $1M in
  February 2025) so this comfortably fits - the point isn't the rate, it's
  knowing it landed. This request auto-saves `paymentId` into a variable;
  run "Payment Status.bru" next to track it.
}

script:post-response {
  if (res.body?.response?.paymentId) {
    bru.setVar("paymentId", res.body.response.paymentId);
  }
}
