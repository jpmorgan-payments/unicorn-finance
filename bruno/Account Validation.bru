meta {
  name: Account Validation
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/tsapi/v2/validations/accounts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  [
    {
      "requestId": "UF1756000001",
      "profileName": "authentication",
      "account": {
        "accountNumber": "8825",
        "financialInstitutionId": {
          "clearingSystemId": { "id": "121000248", "idType": "ABA" }
        }
      }
    }
  ]
}

docs {
  Validates the Palo Alto supplier's routing number and account before the
  $1,000,000 payment goes out. Verification and authentication are asked as
  two separate questions - an account can be real (verification: Open Valid)
  without belonging to who you think (authentication: Ownership No Match).
  This is the "Recent email" example from the Payments Garage deck's "same
  supplier name, three accounts, only one matches" moment - see
  `ValidationServiceConfig.ts`'s `EXAMPLE_ACCOUNTS` and
  `app/client/src/mocks/mockedJson/ValidationServicesAuth.json` for the
  genuine-match and no-match responses this collection's mock server returns.
}
