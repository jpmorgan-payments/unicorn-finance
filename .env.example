# Unicorn Finance - environment configuration
#
# Three tiers, in graduation order:
#   Local Mock   - in-app MSW mock. Offline, NO credentials. Needs none of the below.
#                  `docker compose up` (or `cd app/client && pnpm start`) just works.
#   JPMC Sandbox - PDP's hosted Mock environment (api-mock.payments.jpmorgan.com),
#                  reached with an OAuth2 client-credentials Bearer token.
#   JPMC CAT     - Client Acceptance Testing. Real integration via mTLS + signed JWT.
#
# The JPMC tiers are gated off in the UI until you set VITE_ENABLE_JPMC=true and
# complete the setup below. Copy this file to `.env`. NEVER commit real secrets.

# ============================================================================
# Client (app/client/.env) - baked into the build at build time
# ============================================================================

# Unlock the JPMC Sandbox / JPMC CAT options in the environment switcher.
VITE_ENABLE_JPMC=false

# Dev-proxy targets (only used by `pnpm start`; the container uses nginx).
VITE_MOCKED_API_URL=http://localhost:8081
VITE_CAT_API_URL=http://localhost:8082

# Credential headers sent to JPMC CAT (from your onboarding).
VITE_CLIENT_ID=
VITE_PROGRAM_ID=
VITE_PROGRAM_ID_TYPE=

# ============================================================================
# Server (app/server/.env) - only for the JPMC tiers (never in the browser)
# ============================================================================

# --- JPMC Sandbox: OAuth2 client-credentials (PDP project) ---
# The server exchanges these for a short-lived Bearer token and calls api-mock.
# The client_secret MUST stay server-side - it is never sent to the browser.
PDP_TOKEN_URL=https://id.payments.jpmorgan.com/am/oauth2/alpha/access_token
PDP_OAUTH_SCOPE=jpm:payments:sandbox
PDP_CLIENT_ID=
PDP_CLIENT_SECRET=

# --- JPMC CAT: mTLS + signed JWT ---
# development: read certs from the local files below.
# production: load certs from AWS Secrets Manager under SECRET_NAME.
NODE_ENV=development
SECRET_NAME=
# Client certificates (do NOT commit). Local dev paths (relative to app/server):
#   ../certs/jpmc.key, ../certs/jpmc.crt, ../certs/digital-signature/key.key
# In the `server` container they are mounted at /certs (see compose.yaml).
