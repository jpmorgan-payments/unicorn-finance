{
	"info": {
		"name": "Unicorn Finance - Payments Garage",
		"description": "Raw API calls behind the four Unicorn Finance beats - Global Payments (Reach), FX Rate Sheet (Speed), Account Validation (Confidence) and the Transactions/Balances retrieve side.\n\n`baseUrl` defaults to the local Prism mock-server (`cd app/server/mock-server && docker compose up`, port 8081). Global Payments and Account Validation are backed by the OpenAPI specs in `app/server/mock-server/specs` and work fully offline against it. FX, Transactions and Balances currently run in the app via the in-browser MSW mock (open the app's Request Preview drawer to see them) and against the real CAT sandbox once you are onboarded - their Prism specs are a follow-up.\n\nNo credentials or secrets are stored here. Real (CAT) mode uses mTLS + a signed JWT via the express server - see .env.example.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8081"
		}
	],
	"item": [
		{
			"name": "Global Payments - create payment (Reach)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"requestedExecutionDate\": \"2026-08-20\",\n  \"paymentIdentifiers\": { \"endToEndId\": \"UF1000000000001\" },\n  \"transferType\": \"CREDIT\",\n  \"value\": { \"currency\": \"USD\", \"amount\": \"100\" },\n  \"paymentType\": \"RTP\",\n  \"debtor\": { \"name\": \"RAPID AUDIO LLC\", \"account\": { \"accountNumber\": \"000000010900009\" } },\n  \"creditor\": { \"name\": \"OFFICE 123 INC\", \"account\": { \"accountNumber\": \"000000010975001\" } }\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{baseUrl}}/payment/v2/payments",
					"host": ["{{baseUrl}}"],
					"path": ["payment", "v2", "payments"]
				}
			},
			"response": []
		},
		{
			"name": "FX Rate Sheet (Speed)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"accountId\": \"000000010900009\",\n  \"currency\": \"USD\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{baseUrl}}/fxapi/v1/rate-sheets",
					"host": ["{{baseUrl}}"],
					"path": ["fxapi", "v1", "rate-sheets"]
				},
				"description": "Runs in-app via MSW today; add an FX Prism spec + Caddy route to serve it from the mock-server."
			},
			"response": []
		},
		{
			"name": "Account Validation (Confidence)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "[\n  {\n    \"requestId\": \"UF1000000000001\",\n    \"profileName\": \"authentication\",\n    \"account\": {\n      \"accountNumber\": \"1234559\",\n      \"financialInstitutionId\": { \"clearingSystemId\": { \"id\": \"021000021\", \"idType\": \"ABA\" } }\n    }\n  }\n]",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{baseUrl}}/tsapi/v2/validations/accounts",
					"host": ["{{baseUrl}}"],
					"path": ["tsapi", "v2", "validations", "accounts"]
				}
			},
			"response": []
		},
		{
			"name": "Transactions - retrieve (Beat 4 companion)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/tsapi/v3/transactions",
					"host": ["{{baseUrl}}"],
					"path": ["tsapi", "v3", "transactions"]
				},
				"description": "Runs in-app via MSW today; add a Prism spec + Caddy route to serve it from the mock-server."
			},
			"response": []
		},
		{
			"name": "Account Balances",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"relativeDateType\": \"CURRENT_DAY\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{baseUrl}}/accessapi/balance",
					"host": ["{{baseUrl}}"],
					"path": ["accessapi", "balance"]
				},
				"description": "Runs in-app via MSW today; add a Prism spec + Caddy route to serve it from the mock-server."
			},
			"response": []
		}
	]
}
